# 默认忽略工作过程中的临时文件
*.log
*.tmp
*~
.DS_Store
Thumbs.db

# Python 运行期缓存（各 skill scripts/ 跑动产生，环境产物不入库）
__pycache__/
*.pyc

# 运行期工作区（计划书 §5）
workdir/

# 测试与临时目录
_test*/
sandbox/
output/

# 测试本地隔离依赖（PyYAML 等，pip --target 安装，不入库）
tests/_vendor/

# 本地规划稿（不公开）
docs/投标文件Skill建设计划*.md
docs/专家意见*.md
docs/*评审意见*.md

# 素材母库的「实际条目」（不公开，2026-10-26 起）
# 说明：knowledge/ 下的 README、入库规范.md、tags词表.md、素材条目模板.md 属结构与规范，照常入库；
#       命名字尾 kn-NNN_*.md 的具体条目含企业自有工艺/措施沉淀，仅留本机，不随 git 进 GitHub。
#       本机仍跑 tests/check_knowledge.py 校验（只读本地文件，与 git 是否跟踪无关）。
knowledge/**/kn-*.md

# 企业事实母库（本机 <企业事实母库>\，证书/合同/人员/设备/财务原件数据，绝不入库）
# 该库默认在仓库外；此规则为兜底——一旦有人把目录拷进仓库，也不会被 git add。
企业事实库/
**/企业事实库/

# 会话/工具运行目录与对比报告草稿（不入库）
.dumate/
.opcteam/
tmp/
/自研招投标技能链*核查报告.docx
/自研招投标技能链*核实比对报告.docx

# 由 md 报告派生/docx 交付稿（二进制无法做文本脱敏，且与同名 .md 重复）
# 2026-10-26 起：docs/ 下的 docx 派生报告不再入库，需要时从同名 .md 重新导出。
docs/*.docx

# 审查类工作稿（不入库，2026-11-01 定）
# 背景：交叉审查/核查报告类稿天然含有本机绝对路径（形如 `<本机工作区>\...` 的盘符路径）与
#       真实项目指代，此前做法是逐份手工脱敏——但审查稿自身即为漏点（2026-11-01 实测：
#       审查报告中同时携带了它正在检查的两类敏感串）。改为整类不入库。
#       审稿/核查类新稿建议直接落 workdir/（该目录本已忽略）。
/cross-audit-*.md
/docs/cross-audit-*.md
/docs/*核查报告*.html
/docs/*对标分析*.md
# 注意：`/cross-audit-*.md` 的写法只匹配仓库根（v1.7.52 实测：docs/ 与 evals/ 下的
#       同类稿此前仍被跟踪，规则过窄未达成「整类不入库」）。以下两行补其缺口。
/evals/cross-audit/
/.dumate/

# 01b 规格条目数据（真实招标「技术标准和要求」逐条抄录，2026-11-01 定）
# 属 AGENTS.md:54 红线（招标原文逐条抄录／县市名与乡镇村名／高速口／单位名／文号），
# 不入库。换新项目须按 ① references/技术规范条目抽取规则.md 同口径重新抄录，
# 放入此路径即可被 parse_spec_items.py 自动读取（缺失时产出 items=[] 并告警）。
/skills/bid-response-plan/assets/01b-spec-items.json

# git filter-branch 的临时重写目录（2026-11-01 历史重写后残留，约 3.2MB）
# 注意：filter-branch 要求该目录在运行前不存在，故再次重写前需先手工删除它
#       （或用 `-d <新目录>` 另指定）。此处加规则只为防 `git add` 误提交。
/.git-rewrite/
